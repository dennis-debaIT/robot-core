# Erika Robot Core — Beispiel-Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an.
# Pflichtfelder sind mit (!) markiert.

# ── Zeitzone ──────────────────────────────────────────────────
TZ=Europe/Berlin

# ── LLM (Sprachmodell) ────────────────────────────────────────
# (!) URL zur OpenAI-kompatiblen API (z.B. LM Studio: http://192.168.1.x:1234/v1/chat/completions)
LLM_API_URL=http://192.168.1.x:1234/v1/chat/completions

# API-Key — bei LM Studio/Ollama leer lassen
LLM_API_KEY=

# Provider: openai_compat | generic
LLM_PROVIDER=openai_compat

# Modellname (wie er in der API erscheint)
LLM_MODEL=qwen2.5-3b-instruct

LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=320

# ── Home Assistant ─────────────────────────────────────────────
# (!) URL zu deiner HA-Instanz
ROBOT_HA_URL=http://192.168.1.x:8123

# (!) Long-Lived Access Token aus HA (Profil → Sicherheit → Token erstellen)
ROBOT_HA_TOKEN=

# Alternativ: Benutzername/Passwort (nur wenn kein Token)
ROBOT_HA_USERNAME=
ROBOT_HA_PASSWORD=

# ── Kameras (go2rtc) ──────────────────────────────────────────
ROBOT_GO2RTC_URL=http://192.168.1.x:1984

# ── TTS (Text-to-Speech) ──────────────────────────────────────
# Provider: disabled | edge_tts | sherpa_onnx
ROBOT_TTS_PROVIDER=disabled

# Edge TTS: Stimmenname (z.B. de-DE-KatjaNeural)
ROBOT_TTS_VOICE_LABEL=

# Sherpa ONNX: Pfade zu Modelldateien (im Container unter /models/tts/)
ROBOT_TTS_VITS_MODEL=
ROBOT_TTS_TOKENS=
ROBOT_TTS_DATA_DIR=
ROBOT_TTS_LEXICON=
ROBOT_TTS_RULE_FSTS=
ROBOT_TTS_SPEED=1.0
ROBOT_TTS_SPEAKER_ID=0
ROBOT_TTS_NUM_THREADS=2

# ── Persönlichkeit ────────────────────────────────────────────
# Alle Werte zwischen 0.0 und 1.0
ROBOT_DEFAULT_FRIENDLINESS=0.9
ROBOT_DEFAULT_HUMOR=0.65
ROBOT_DEFAULT_CURIOSITY=0.75
ROBOT_DEFAULT_TALKATIVENESS=0.45
ROBOT_DEFAULT_CAUTION=0.8
ROBOT_DEFAULT_DIRECTNESS=0.7
ROBOT_DEFAULT_SARCASM=0.15
ROBOT_DEFAULT_PATIENCE=0.85

# ── Verhalten ─────────────────────────────────────────────────
ROBOT_RESPONSE_STYLE=kurz, freundlich und präzise
ROBOT_EXPLAIN_ONLY_ON_REQUEST=true
ROBOT_QUIET_MINUTES=5
ROBOT_CRITICAL_BATTERY_THRESHOLD=20
ROBOT_LLM_TIMEOUT_SECONDS=45
ROBOT_LLM_MAX_TOKENS=320
ROBOT_GREETING_SUGGESTION_TEMPLATE=Kurze Begrüßung für {person_name} vorschlagen.

# ── Einkaufsliste / Sync-Server ───────────────────────────────
# URL des erika-sync-server (leer lassen wenn kein Sync gewünscht)
SHOPPING_SYNC_URL=https://erika.wdk-it.de:9000
# Token aus dem setup.sh-Output des Sync-Servers
SHOPPING_SYNC_TOKEN=

# ── SSH (für Update-Skripte) ───────────────────────────────────
# Pfad zum SSH-Schlüssel-Verzeichnis auf dem Host
SSH_DIR=/home/dennis/.ssh
